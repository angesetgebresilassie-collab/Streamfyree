# Optional AI configuration
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Spotify Web API (Client Credentials flow) — used for the Spotify playlist
# feed. Get a free Client ID/Secret at https://developer.spotify.com/dashboard.
# Do NOT put these in gradle.properties (it's committed to the repo). Instead,
# export them as environment variables before building, e.g.:
#   export SPOTIFY_CLIENT_ID=your_id
#   export SPOTIFY_CLIENT_SECRET=your_secret
# or add them to your user-level ~/.gradle/gradle.properties, which is never
# committed. In CI, set them as repository secrets instead.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
